__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Pasted-but-unvalidated JSON is working state, not a final artifact — a
# rejected paste sits here until the chat re-emits it, then the file is
# gone (moved to tt_cards/ or deleted). Nothing here is meant to survive
# a commit.
inbox/*.json
!inbox/.gitkeep

# Real broker-measured / owner-asserted data. This repo is private, so
# unlike MacroDash (public — real book/position data may never enter that
# repo) these COULD be committed here. They stay gitignored anyway: each is
# a live export/manual refresh the owner updates locally, not a
# reviewed/edited artifact like a tt_card, and a stale committed copy would
# be worse than no copy (silently wrong weights, cap checks, or quotes).
# The matching .example.json in each case IS committed and shows the shape.
holdings.json
roster.json
quotes.json

# run_queue.md is regenerated by every `python -m tt.rank` run — it's
# working output for the next chat session to paste, not a reviewed
# artifact worth a git history of its own.
run_queue.md
