# Production build default (Vite reads this during `npm run build` / Cloudflare Pages).
# Makes the deployed dashboard FETCH /api/snapshot and overlay live data instead of
# rendering the pure MOCK_DATA baseline. Mock remains the always-present runtime fallback
# (graceful degradation) — a failed live fetch sets mode ERROR (v3.59 B1): mock renders
# underneath as ILLUSTRATIVE with a visible outage line + RETRY, never dressed as live —
# so the dashboard never breaks. An explicit VITE_DATA_MODE var in Pages overrides this.
VITE_DATA_MODE=live
